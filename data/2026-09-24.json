      {
        "day": "Dienstag",
        "title": "Hendl-Streifen mit Reis, Karottengemüse und Gurkensalat",
        "minutes": 30,
        "ingredients": [
          "700 g Hendl-Filet natur",
          "300 g Reis",
          "400 g Karotten",
          "150 g Sauerrahm",
          "1 Zwiebel",
          "1 Gurke"
        ],
        "deals": [
          "Hendl-Filet",
          "Karotten",
          "Sauerrahm",
          "Zwiebeln",
          "Gurke"
        ],
        "steps": [
          "Reis mit der doppelten Menge Salzwasser aufsetzen und zugedeckt 20 Minuten quellen lassen.",
          "Hendl-Filet in fingerdicke Streifen schneiden, mit Salz, Pfeffer und Paprikapulver würzen.",
          "Karotten in Scheiben schneiden, Zwiebel in Spalten.",
          "Fleisch in heißem Öl 4 bis 5 Minuten rundum anbraten, herausnehmen und warm stellen.",
          "Zwiebel und Karotten in derselben Pfanne 6 Minuten braten, 100 ml Wasser angießen und weich dünsten.",
          "Fleisch zurück in die Pfanne, Sauerrahm einrühren und nur noch heiß werden lassen, nicht kochen. Mit Reis servieren."
        ]
      },
      {
        "day": "Mittwoch",
        "title": "Butternuss-Kürbiscremesuppe mit Käsebroten",
        "minutes": 30,
        "ingredients": [
          "1 kg Butternuss-Kürbis",
          "2 Karotten",
          "1 Zwiebel",
          "250 ml Rama Cremefine",
          "1 l Suppe",
          "Käsescheiben und Brot"
        ],
        "deals": [
          "Butternuss-Kürbis",
          "Karotten",
          "Zwiebeln",
          "Cremefine",
          "Käsescheiben"
        ],
        "steps": [
          "Kürbis schälen, halbieren, die Kerne ausschaben und in 2 cm große Würfel schneiden.",
          "Zwiebel und Karotten fein würfeln und in Butter 5 Minuten anschwitzen.",
          "Kürbis zugeben, mit 1 l Suppe aufgießen und 20 Minuten weich kochen.",
          "Mit dem Stabmixer fein pürieren, Cremefine einrühren, mit Salz und einer Prise Muskat abschmecken.",
          "Brot mit Käsescheiben belegen, im Rohr überbacken und zur Suppe servieren."
        ]
      },
      {
        "day": "Donnerstag",
        "title": "Kaiserschmarrn mit Apfelmus",
        "minutes": 35,
        "ingredients": [
          "4 Eier",
          "250 ml Milch",
          "200 g Mehl",
          "1 kg Äpfel",
          "Butter",
          "Zucker und Staubzucker"
        ],
        "deals": [
          "Eier",
          "Milch",
          "Äpfel"
        ],
        "steps": [
          "Eier trennen, das Eiklar mit einer Prise Salz steif schlagen.",
          "Dotter mit Milch, Mehl und 1 EL Zucker glatt rühren, dann den Eischnee locker unterheben.",
          "Butter in einer großen Pfanne schmelzen, Teig eingießen und bei mittlerer Hitze 4 Minuten stocken lassen.",
          "Wenden, mit zwei Gabeln in Stücke reißen und unter Rühren goldbraun fertig backen.",
          "Äpfel schälen, würfeln, mit 2 EL Wasser und etwas Zucker 10 Minuten weich kochen und zerdrücken.",
          "Schmarrn mit Staubzucker bestreuen und mit dem Apfelmus servieren."
        ]
      },
      {
        "day": "Freitag",
        "title": "Faschierte Laibchen mit Kartoffelpüree und Karotten",
        "minutes": 40,
        "ingredients": [
          "500 g Faschiertes (Rest von Montag)",
          "1 Ei",
          "Semmelbrösel",
          "1 Zwiebel",
          "800 g Kartoffeln",
          "300 g Karotten",
          "Milch"
        ],
        "deals": [
          "Faschiertes",
          "Eier",
          "Zwiebeln",
          "Karotten",
          "Milch"
        ],
        "steps": [
          "Kartoffeln schälen, würfeln und in Salzwasser 20 Minuten weich kochen.",
          "Zwiebel fein hacken. Faschiertes mit Zwiebel, Ei, 4 EL Semmelbröseln, Salz, Pfeffer und Majoran verkneten, 10 Minuten rasten lassen.",
          "Karotten in Scheiben schneiden und in wenig Salzwasser mit einem Stück Butter 10 Minuten dünsten.",
          "Aus der Masse 8 Laibchen formen und in Öl je Seite 5 Minuten bei mittlerer Hitze braten.",
          "Kartoffeln abseihen, mit heißer Milch und Butter stampfen und abschmecken.",
          "Laibchen mit Püree und Karotten anrichten."
        ]
      }
